# Temporary udev rule for non-root USB access to Actions ATJ229R2 (10KTF Kagami)
# Install:   sudo cp udev/99-kagami-usb.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger
# Uninstall: sudo rm /etc/udev/rules.d/99-kagami-usb.rules && sudo udevadm control --reload-rules
SUBSYSTEM=="usb", ATTR{idVendor}=="10d6", MODE="0666"
SUBSYSTEM=="scsi_generic", ATTRS{idVendor}=="10d6", MODE="0666"
